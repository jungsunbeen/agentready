{
  "name": "agent-lint",
  "version": "0.1.0",
  "description": "Check whether a repository is ready for AI coding agents.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "cli",
    "lint",
    "developer-experience"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "docs": "node dist/cli.js rules --markdown > docs/rules.md",
    "check:self": "node dist/cli.js check . --fail-under 100"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jungsunbeen/agent-lint.git"
  }
}
